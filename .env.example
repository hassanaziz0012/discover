# PostgreSQL Database Credentials
POSTGRES_DB=discover_db
POSTGRES_USER=discover_user
POSTGRES_PASSWORD=discover_password

# Database Connection (Container Network)
DATABASE_URL=postgresql+psycopg://discover_user:discover_password@db:5432/discover_db

# API Keys (Copied from discover_api/.env)
YOUTUBE_API_KEY=your_youtube_api_key
YOUTUBE_CHANNEL_ID=your_channel_id
GEMINI_API_KEY_1=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key

# CORS & Frontend API Base
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Profiler Configuration
ENABLE_PROFILER=true

